<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.tob.mapper.SpuImageMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.SpuImage">
        <id column="id" property="id"/>
        <result column="spu_id" property="spuId"/>
        <result column="image_url" property="imageUrl"/>
        <result column="sort" property="sort"/>
    </resultMap>

    <select id="selectBySpuId" resultMap="BaseResultMap">
        SELECT * FROM t_spu_image WHERE spu_id = #{spuId} ORDER BY sort ASC, id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_spu_image (spu_id, image_url, sort) VALUES (#{spuId}, #{imageUrl}, #{sort})
    </insert>

    <delete id="deleteBySpuId">
        DELETE FROM t_spu_image WHERE spu_id = #{spuId}
    </delete>
</mapper>
