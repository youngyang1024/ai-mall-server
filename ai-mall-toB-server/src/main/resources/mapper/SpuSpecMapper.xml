<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.tob.mapper.SpuSpecMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.SpuSpec">
        <id column="id" property="id"/>
        <result column="spu_id" property="spuId"/>
        <result column="spec_name" property="specName"/>
        <result column="spec_values" property="specValues"/>
    </resultMap>

    <select id="selectBySpuId" resultMap="BaseResultMap">
        SELECT * FROM t_spu_spec WHERE spu_id = #{spuId} ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_spu_spec (spu_id, spec_name, spec_values) VALUES (#{spuId}, #{specName}, #{specValues})
    </insert>

    <delete id="deleteBySpuId">
        DELETE FROM t_spu_spec WHERE spu_id = #{spuId}
    </delete>
</mapper>
