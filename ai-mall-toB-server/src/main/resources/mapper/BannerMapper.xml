<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.tob.mapper.BannerMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.Banner">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="image_url" property="imageUrl"/>
        <result column="link_url" property="linkUrl"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM t_banner ORDER BY sort ASC, id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM t_banner WHERE id = #{id} LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_banner (title, image_url, link_url, sort, status)
        VALUES (#{title}, #{imageUrl}, #{linkUrl}, #{sort}, #{status})
    </insert>

    <update id="update">
        UPDATE t_banner
        SET title = #{title}, image_url = #{imageUrl}, link_url = #{linkUrl},
            sort = #{sort}, status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_banner WHERE id = #{id}
    </delete>
</mapper>
