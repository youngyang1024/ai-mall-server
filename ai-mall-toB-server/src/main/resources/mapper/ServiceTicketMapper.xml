<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.tob.mapper.ServiceTicketMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.ServiceTicket">
        <id column="id" property="id"/>
        <result column="ticket_no" property="ticketNo"/>
        <result column="user_id" property="userId"/>
        <result column="category_id" property="categoryId"/>
        <result column="category_name" property="categoryName"/>
        <result column="issue_id" property="issueId"/>
        <result column="issue_name" property="issueName"/>
        <result column="order_no" property="orderNo"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="contact_first_name" property="contactFirstName"/>
        <result column="contact_last_name" property="contactLastName"/>
        <result column="contact_email" property="contactEmail"/>
        <result column="contact_area_code" property="contactAreaCode"/>
        <result column="contact_phone" property="contactPhone"/>
        <result column="last_reply_user_type" property="lastReplyUserType"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM t_service_ticket
        <where>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="ticketNo != null and ticketNo != ''">
                AND ticket_no LIKE CONCAT('%', #{ticketNo}, '%')
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no LIKE CONCAT('%', #{orderNo}, '%')
            </if>
        </where>
        ORDER BY update_time DESC, id DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM t_service_ticket WHERE id = #{id} LIMIT 1
    </select>

    <update id="updateStatus">
        UPDATE t_service_ticket
        SET status = #{status}, update_time = NOW()
        WHERE id = #{id}
    </update>

    <update id="updateStatusAndLastReply">
        UPDATE t_service_ticket
        SET status = #{status},
            last_reply_user_type = #{lastReplyUserType},
            update_time = NOW()
        WHERE id = #{id}
    </update>
</mapper>
