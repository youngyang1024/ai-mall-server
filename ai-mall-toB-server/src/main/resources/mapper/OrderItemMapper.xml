<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.tob.mapper.OrderItemMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.OrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="spu_id" property="spuId"/>
        <result column="sku_id" property="skuId"/>
        <result column="spu_name" property="spuName"/>
        <result column="sku_spec" property="skuSpec"/>
        <result column="image" property="image"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT * FROM t_order_item WHERE order_id = #{orderId}
    </select>
</mapper>
