<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.tob.mapper.OrderMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.Order">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="discount_amount" property="discountAmount"/>
        <result column="pay_amount" property="payAmount"/>
        <result column="coupon_id" property="couponId"/>
        <result column="status" property="status"/>
        <result column="receiver_info" property="receiverInfo"/>
        <result column="remark" property="remark"/>
        <result column="logistics_no" property="logisticsNo"/>
        <result column="pay_time" property="payTime"/>
        <result column="ship_time" property="shipTime"/>
        <result column="finish_time" property="finishTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM t_order
        <where>
            <if test="orderNo != null and orderNo != ''">
                AND order_no LIKE CONCAT('%', #{orderNo}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM t_order WHERE order_no = #{orderNo} LIMIT 1
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM t_order WHERE id = #{id} LIMIT 1
    </select>

    <update id="updateShip">
        UPDATE t_order SET status = 2, logistics_no = #{logisticsNo}, ship_time = #{shipTime}
        WHERE id = #{id} AND status = 1
    </update>

    <update id="updateStatus">
        UPDATE t_order SET status = #{toStatus}
        WHERE id = #{id} AND status = #{fromStatus}
    </update>

    <update id="updateToRefunded">
        UPDATE t_order SET status = 6 WHERE id = #{id} AND status = 5
    </update>
</mapper>
