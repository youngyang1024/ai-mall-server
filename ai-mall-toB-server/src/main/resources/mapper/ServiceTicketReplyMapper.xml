<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.tob.mapper.ServiceTicketReplyMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.ServiceTicketReply">
        <id column="id" property="id"/>
        <result column="ticket_id" property="ticketId"/>
        <result column="user_type" property="userType"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_service_ticket_reply (ticket_id, user_type, user_id, content)
        VALUES (#{ticketId}, #{userType}, #{userId}, #{content})
    </insert>

    <select id="selectByTicketId" resultMap="BaseResultMap">
        SELECT * FROM t_service_ticket_reply
        WHERE ticket_id = #{ticketId}
        ORDER BY id ASC
    </select>
</mapper>
