<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <!-- 参考 link-backend-jobs 的 logback 配置；本工程无 SkyWalking，去掉 %tid 与 TraceId layout -->
    <property name="LOG_PATTERN"
              value="[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%-5level] [%thread] [%logger] - %msg%n"/>
    <property name="LOG_DIR" value="${log.dir:-logs}"/>
    <property name="LOG_APP_NAME" value="ai-mall-toC"/>
    <property name="LOG_PATH" value="${LOG_DIR}/${LOG_APP_NAME}"/>

    <!--控制台日志打印-->
    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%highlight(%-5level)] [%yellow(%thread)] [%green(%logger{36})] - %msg%n</pattern>
        </encoder>
    </appender>

    <!--错误日志文件（WARN 及以上）-->
    <appender name="errorFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error/${LOG_APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error/${LOG_APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!--全量日志文件-->
    <appender name="fileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/info/${LOG_APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/info/${LOG_APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- MyBatis SQL 日志（Slf4jImpl 走 DEBUG 级别），生产可调回 INFO -->
    <logger name="com.aimall.toc.mapper" level="DEBUG"/>

    <root level="INFO">
        <springProfile name="dev,docker">
            <appender-ref ref="stdout"/>
        </springProfile>
        <appender-ref ref="fileAppender"/>
        <appender-ref ref="errorFileAppender"/>
    </root>

</configuration>
