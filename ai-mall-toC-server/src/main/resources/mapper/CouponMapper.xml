<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.toc.mapper.CouponMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.Coupon">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="threshold" property="threshold"/>
        <result column="discount" property="discount"/>
        <result column="total_count" property="totalCount"/>
        <result column="received_count" property="receivedCount"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM t_coupon WHERE id = #{id} LIMIT 1
    </select>

    <select id="selectAvailable" resultMap="BaseResultMap">
        SELECT * FROM t_coupon
        WHERE status = 1 AND received_count &lt; total_count
          AND start_time &lt;= NOW() AND end_time &gt;= NOW()
        ORDER BY id DESC
    </select>

    <update id="incrementReceivedCount">
        UPDATE t_coupon SET received_count = received_count + 1
        WHERE id = #{id} AND received_count &lt; total_count
    </update>
</mapper>
