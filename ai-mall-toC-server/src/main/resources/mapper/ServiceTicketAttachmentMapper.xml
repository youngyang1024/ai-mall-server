<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.toc.mapper.ServiceTicketAttachmentMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.ServiceTicketAttachment">
        <id column="id" property="id"/>
        <result column="ticket_id" property="ticketId"/>
        <result column="reply_id" property="replyId"/>
        <result column="user_type" property="userType"/>
        <result column="file_name" property="fileName"/>
        <result column="file_url" property="fileUrl"/>
        <result column="file_type" property="fileType"/>
        <result column="file_size" property="fileSize"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_service_ticket_attachment (
            ticket_id, reply_id, user_type, file_name, file_url, file_type, file_size
        ) VALUES (
            #{ticketId}, #{replyId}, #{userType}, #{fileName}, #{fileUrl}, #{fileType}, #{fileSize}
        )
    </insert>

    <select id="selectByTicketId" resultMap="BaseResultMap">
        SELECT * FROM t_service_ticket_attachment
        WHERE ticket_id = #{ticketId}
        ORDER BY id ASC
    </select>
</mapper>
