<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.toc.mapper.ServiceCategoryMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.ServiceCategory">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="icon" property="icon"/>
        <result column="need_order_no" property="needOrderNo"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectEnabledList" resultMap="BaseResultMap">
        SELECT * FROM t_service_category
        WHERE status = 1
        ORDER BY sort ASC, id ASC
    </select>
</mapper>
