<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.toc.mapper.CategoryMapper">
    <resultMap id="BaseResultMap" type="com.aimall.common.entity.Category">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    <select id="selectEnabled" resultMap="BaseResultMap">
        SELECT id, name, parent_id, sort, status, create_time FROM t_category WHERE status = 1 ORDER BY sort ASC, id ASC
    </select>
</mapper>
