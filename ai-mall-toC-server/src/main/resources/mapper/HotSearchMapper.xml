<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimall.toc.mapper.HotSearchMapper">

    <resultMap id="BaseResultMap" type="com.aimall.common.entity.HotSearch">
        <id column="id" property="id"/>
        <result column="keyword" property="keyword"/>
        <result column="is_hot" property="isHot"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectEnabled" resultMap="BaseResultMap">
        SELECT * FROM t_hot_search WHERE status = 1 ORDER BY sort ASC, id DESC
    </select>

</mapper>